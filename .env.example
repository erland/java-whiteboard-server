# Public URL used by the test edge setup.
# Use http://localhost for local tryout, or e.g. http://serverxxx for a remote test host.
PUBLIC_BASE_URL=http://localhost

# Optional image overrides for the GHCR-first test stack.
EDGE_NGINX_IMAGE=nginx:1.27-alpine
PWA_IMAGE=ghcr.io/erland/pwa-whiteboard:latest
SERVER_IMAGE=ghcr.io/erland/java-whiteboard-server:latest
POSTGRES_IMAGE=postgres:16
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0

# The test stack is intentionally configured for plain HTTP so it can run both
# at http://localhost and at a remote test host like http://serverxxx without TLS.

# The test PWA runtime config derives its OIDC issuer from PUBLIC_BASE_URL.


# The backend validates REST and WebSocket bearer tokens against the same public issuer.
# The issuer is derived from PUBLIC_BASE_URL, while JWKS is fetched internally via edge-nginx.
